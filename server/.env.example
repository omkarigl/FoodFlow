# ---------------------------------------------------------------------------
# FoodFlow server environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=5000
# Public origin of the frontend (used for Razorpay redirect + CORS allow-list)
CLIENT_URL=http://localhost:5173
# Comma separated list of extra allowed origins
EXTRA_ORIGINS=

# Database — FREE options (pick one):
# 1) MongoDB Atlas M0 (free forever, persistent, recommended for production):
#    https://cloud.mongodb.com → free M0 cluster → Connect → copy URI, e.g.:
#    MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/foodflow?retryWrites=true&w=majority
# 2) Local MongoDB (free, needs `mongod` installed):
MONGODB_URI=mongodb://127.0.0.1:27017/foodflow
# 3) Zero-setup ephemeral Mongo (free, no install, NOT persistent):
#    npm run dev:mem  (uses mongodb-memory-server, same MongoDB engine)

# Auth  (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Used to sign cookies as well
COOKIE_SECRET=replace-with-another-long-random-secret

# Bootstrap admin (created by `npm run seed` only)
ADMIN_NAME=Canteen Admin
ADMIN_EMAIL=admin@foodflow.edu
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=9000000000

# User accounts — Supabase Postgres (system of record for accounts).
# Supabase dashboard: Project Settings > API. The service_role key is
# SERVER-ONLY (bypasses RLS): never commit it, never expose it to the frontend.
# Run server/supabase/schema.sql once in the Supabase SQL Editor to create the table.
SUPABASE_URL=https://xkssgwkmvxikvxujciwb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay  (https://dashboard.razorpay.com/app/keys)
# Test keys are safe for development. NEVER commit live secret keys.
# Production: set these in your host dashboard (Render/Vercel env vars), not in git.
# Leave RAZORPAY_KEY_ID empty ONLY if you want to run with PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=rzp_test_ThWJn7gn5ykCVw
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# razorpay | sandbox   (sandbox = local emulator of the Razorpay checkout used for
# offline development; it performs the same server side HMAC verification)
PAYMENT_PROVIDER=razorpay

# Socket.IO polling fallback interval hint (ms) exposed to the client
REALTIME_POLL_INTERVAL=15000