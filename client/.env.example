# FoodFlow frontend environment.
# Local dev: leave empty (Vite proxies /api + /socket.io to localhost:5000).
# Production (Vercel dashboard > Settings > Environment Variables):
#   VITE_API_URL     = https://<backend-host>   (no trailing slash, no /api)
#   VITE_SOCKET_URL  = https://<backend-host>   (same origin as the API)
VITE_API_URL=
VITE_SOCKET_URL=
