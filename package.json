{
  "name": "foodflow",
  "version": "1.0.0",
  "private": true,
  "description": "FoodFlow - campus canteen ordering: menu, cart, Razorpay checkout, coupons, receipts and recommendations.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
